NEXT_PUBLIC_SANITY_PROJECT_ID=kjf580ay
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_PREVIEW_ENABLED=true
# Server only: viewer token for private draft previews. Never add NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# Private owner editor: server-only content editor credential, separate from preview.
SANITY_API_WRITE_TOKEN=
# Vercel: restricted Postgres runtime connection string; never NEXT_PUBLIC_.
OWNER_DATABASE_URL=
# Standalone server only: absolute path on durable, private storage (single server).
# Never inside public/, .next/, a source bundle, or an ephemeral/serverless filesystem.
OWNER_AUTH_DB=
# Exact production HTTPS origin, no trailing slash. Passkeys are bound to this hostname.
# Local default: http://localhost:3000
OWNER_SITE_ORIGIN=
